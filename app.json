{
  "expo": {
    "name": "Amp Store",
    "slug": "eshop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eshop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#17211D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ampdevs.eshop",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "estorebackend.amptechnology.in",
              "pathPrefix": "/store"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17211D",
          "image": "./assets/images/s1.png",
          "imageWidth": 200,
          "resizeMode": "cover"
        }
      ],
      "expo-video",
      "expo-image",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ESHOP to use the camera to scan store QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-firebase/app/app.plugin.js",
      [
        "expo-build-properties",
        {
          "android": {}
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow ESHOP to use the microphone for voice search.",
          "speechRecognitionPermission": "Allow ESHOP to use speech recognition for voice search."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow ESHOP to use your location to fill in your delivery address."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba1831e8-eef3-4f75-acb8-9732ee9d3c50"
      }
    },
    "owner": "ampdevs425"
  }
}
